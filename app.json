{
  "expo": {
    "name": "Pawmi",
    "slug": "pawmi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pawmi-icon.png",
    "scheme": "pawmiapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/pawmi-icon.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/images/pawmi-icon.png",
        "monochromeImage": "./assets/images/pawmi-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guminji.pawmiapp",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "image": "./assets/images/pawmi-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "pawmi-app",
          "organization": "pawmi-app"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba2588c5-03ee-4364-b34e-45aa4fb41042"
      }
    },

    "owner": "guminji8161"
  }
}
